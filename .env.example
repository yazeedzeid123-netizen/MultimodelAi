# Optional backend settings. The mock workflow requires no credentials.
AURA_MODE=mock
AURA_CONFIG_PATH=config/config.yaml
AURA_STORAGE_PATH=./var/aura.sqlite3

# Optional OpenAI-compatible provider. Leave blank for deterministic local analysis.
# Select model identifiers available to your configured provider; no model is assumed.
AURA_OPENAI_API_KEY=
AURA_OPENAI_BASE_URL=https://api.openai.com/v1
AURA_OPENAI_VISION_MODEL=
AURA_OPENAI_TRANSCRIPTION_MODEL=
AURA_OPENAI_TEXT_MODEL=
AURA_VIDEO_MAX_SECONDS=60
AURA_ANALYSIS_TIMEOUT_SECONDS=120

# Next.js forwards same-origin /api requests to this server-side backend URL.
AURA_BACKEND_URL=http://127.0.0.1:8000